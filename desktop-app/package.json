{
  "name": "kestrova",
  "version": "0.3.0",
  "description": "Kestrova optical design software",
  "main": "electron/main.js",
  "author": "Brendan Ryan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"npm --prefix ../frontend run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build:frontend": "npm --prefix ../frontend run build",
    "build:backend": "cd ../backend && pyinstaller --noconfirm --clean kestrova-server.spec",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win --publish=never",
    "dist:mac": "electron-builder --mac --publish=never",
    "pack": "electron-builder --dir --publish=never"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "cross-env": "7.0.3",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "com.kestrova.app",
    "productName": "Kestrova",
    "artifactName": "Kestrova-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/kestrova-server",
        "to": "backend/kestrova-server"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png",
      "category": "Science"
    }
  }
}
